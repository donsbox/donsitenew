---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="404 · Don" description="未找到页面 / Page not found" noindex={true}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <p class="text-sm text-muted-foreground">404</p>
    <h1 class="mt-4 text-4xl font-semibold">未找到页面 / Page not found</h1>
    <p class="mt-6 text-muted-foreground">请从首页浏览当前作品集。 / Explore the current portfolio from the home page.</p>
    <div class="mt-8 flex gap-6"><a href="/" class="underline">中文首页</a><a href="/en/" class="underline">English home</a></div>
  </main>
</BaseLayout>
