---
import HeadSEO from "../components/HeadSEO.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { labels, type Language } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
  alternatePaths?: Partial<Record<Language, string>>;
  noindex?: boolean;
  pageType?: "website" | "article";
}
const { lang = "zh-CN", ...seo } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <HeadSEO {...seo} lang={lang} />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        document.documentElement.classList.toggle("dark", theme ? theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches);
      } catch {}
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <a href="#main-content" class="skip-link">{labels[lang].skip}</a>
    <Header lang={lang} alternatePaths={seo.alternatePaths} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
