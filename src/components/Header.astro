---
import { ModeToggle } from "./react/ThemeToggle";
import { PROFILE } from "../content/profileData";
import { homePath, projectsPath, labels, type Language } from "../lib/i18n";
interface Props { lang: Language; alternatePaths?: Partial<Record<Language, string>>; }
const { lang, alternatePaths = {} } = Astro.props;
const t = labels[lang];
const other = lang === "en" ? "zh-CN" : "en";
---
<header class="border-b bg-background/95">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-8">
    <a href={homePath(lang)} class="flex items-center gap-3 font-semibold" aria-label={lang === "en" ? "Don — Home" : "Don — 首页"}>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-foreground text-background" aria-hidden="true">D.</span>
      <span>{PROFILE.name}</span>
    </a>
    <nav class="flex flex-wrap items-center gap-4 text-sm sm:gap-6" aria-label={lang === "en" ? "Main navigation" : "主导航"}>
      <a href={projectsPath(lang)}>{t.projects}</a>
      <a href={homePath(lang) + "#contact"}>{t.contact}</a>
      {alternatePaths[other] && <a href={alternatePaths[other]} lang={other} hreflang={other} class="rounded-full border px-3 py-1">{other === "en" ? "EN" : "中文"}</a>}
      <ModeToggle label={t.theme} client:load />
    </nav>
  </div>
</header>
