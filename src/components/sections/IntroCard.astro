---
import { PROFILE } from "../../content/profileData";
import type { Language } from "../../lib/i18n";
interface Props { lang: Language; }
const { lang } = Astro.props;
const copy = PROFILE.locales[lang];
---
<div class="flex h-full flex-col justify-between gap-8">
  <div>
    <p class="mb-5 text-sm font-medium text-primary">{PROFILE.name} / {copy.role}</p>
    <h1 class="max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">{copy.introduction}</h1>
    <p class="mt-7 max-w-2xl text-base leading-8 text-muted-foreground">{copy.summary}</p>
  </div>
  <a class="w-fit text-sm font-semibold underline underline-offset-4" href={PROFILE.links.github} target="_blank" rel="noreferrer">GitHub / donsbox ↗</a>
</div>

