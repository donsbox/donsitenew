---
import { PROFILE } from "../../content/profileData";
import type { Language } from "../../lib/i18n";
interface Props { lang: Language; }
const { lang } = Astro.props;
const copy = PROFILE.locales[lang];
---
<p class="text-sm leading-7 text-muted-foreground">{copy.about}</p>
<ul class="mt-6 space-y-4 text-sm">
  {copy.capabilities.map((capability, index) => (
    <li class="flex gap-3"><span class="font-mono text-primary">0{index + 1}</span><span>{capability}</span></li>
  ))}
</ul>

