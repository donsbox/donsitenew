---
import { PROFILE } from "../../content/profileData";
import type { Language } from "../../lib/i18n";
interface Props { lang: Language; }
const { lang } = Astro.props;
---
<div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
  <p class="max-w-2xl text-sm leading-7 text-muted-foreground">{PROFILE.locales[lang].contact}</p>
  <a href={PROFILE.links.github} target="_blank" rel="noreferrer" class="w-fit shrink-0 rounded-xl bg-foreground px-5 py-3 text-sm font-medium text-background">GitHub ↗</a>
</div>

