---
interface Props { title?: string; class?: string; id?: string; }
const { title, class: className = "", id } = Astro.props;
---
<section id={id} class={`rounded-2xl border bg-card p-6 sm:p-8 ${className}`}>
  {title && <h2 class="mb-5 text-sm font-semibold text-muted-foreground">{title}</h2>}
  <slot />
</section>
