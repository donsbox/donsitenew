---
import "@/styles/globals.css";
import { PROFILE } from "../content/profileData";
import { type Language } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
  alternatePaths?: Partial<Record<Language, string>>;
  noindex?: boolean;
  pageType?: "website" | "article";
}
const { lang = "zh-CN", alternatePaths = {}, noindex = false, pageType = "website" } = Astro.props;
const profile = PROFILE.locales[lang];
const title = Astro.props.title ?? profile.title;
const description = Astro.props.description ?? profile.description;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const image = Astro.site ? new URL("/og-card.png", Astro.site) : undefined;
const indexable = Boolean(Astro.site) && !noindex;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  inLanguage: lang,
  ...(canonical ? { url: canonical.href } : {}),
  about: {
    "@type": "Person",
    name: PROFILE.name,
    jobTitle: lang === "en" ? "Product Manager" : "产品经理",
    sameAs: [PROFILE.links.github],
  },
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={indexable ? "index, follow" : "noindex, nofollow"} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={PROFILE.name} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{canonical && <link rel="canonical" href={canonical} />}
{Astro.site && !noindex && Object.entries(alternatePaths).map(([locale, path]) => (
  <link rel="alternate" hreflang={locale} href={new URL(path, Astro.site)} />
))}
{Astro.site && !noindex && alternatePaths["zh-CN"] && (
  <link rel="alternate" hreflang="x-default" href={new URL(alternatePaths["zh-CN"], Astro.site)} />
)}
<meta property="og:site_name" content="Don · Product Portfolio" />
<meta property="og:type" content={pageType} />
<meta property="og:locale" content={lang === "en" ? "en_US" : "zh_CN"} />
<meta property="og:locale:alternate" content={lang === "en" ? "zh_CN" : "en_US"} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{image && <>
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Don · AI Product Portfolio" />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:image:alt" content="Don · AI Product Portfolio" />
</>}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
