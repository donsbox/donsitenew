---
import { PROFILE } from "../content/profileData";
import { labels, type Language } from "../lib/i18n";
interface Props { lang: Language; }
const { lang } = Astro.props;
const t = labels[lang];
---
<footer class="mx-auto mt-12 max-w-6xl border-t px-5 py-8 text-xs text-muted-foreground sm:px-8">
  <div class="flex flex-wrap justify-between gap-4">
    <p>© {new Date().getFullYear()} {PROFILE.name} · {t.portfolio}</p>
    <div class="flex flex-wrap gap-5">
      <a href={PROFILE.repo} rel="noreferrer" target="_blank">{t.repository} ↗</a>
      <a href="https://github.com/tim-hub/techtim-astro-bento-portfolio" rel="noreferrer" target="_blank">{t.attribution} ↗</a>
    </div>
  </div>
</footer>
