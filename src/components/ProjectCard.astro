---
import { labels, projectPath, type Language } from "../lib/i18n";
import type { Project } from "../lib/projects";
interface Props { project: Project; lang: Language; }
const { project, lang } = Astro.props;
const { data } = project;
const t = labels[lang];
---
<article class="flex h-full flex-col rounded-2xl border bg-card p-6 sm:p-8" data-project-id={data.projectId}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 text-xs">
    <span class="rounded-full bg-secondary px-3 py-1.5 font-medium">{t[data.stage]}</span>
    <span class="font-mono text-muted-foreground">0{data.order}</span>
  </div>
  <h3 class="text-2xl font-semibold tracking-tight">
    <a href={projectPath(lang, data.projectId)}>{data.title}</a>
  </h3>
  <p class="mt-2 font-medium text-primary">{data.subtitle}</p>
  <p class="mt-4 flex-1 text-sm leading-7 text-muted-foreground">{data.description}</p>
  <ul class="mt-5 flex flex-wrap gap-2 text-xs" aria-label={lang === "en" ? "Product themes" : "产品主题"}>
    {data.tags.map(tag => <li class="rounded-md border px-2 py-1">{tag}</li>)}
  </ul>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t pt-5 text-xs">
    <span class="text-muted-foreground">{t.reviewed} <time datetime={data.reviewedAt}>{data.reviewedAt}</time></span>
    <a class="font-semibold" href={projectPath(lang, data.projectId)}>{t.read} →</a>
  </div>
</article>
